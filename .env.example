# --- Required ---
# Token from @BotFather
BOT_TOKEN=123456:replace-me
# Comma-separated Telegram user IDs allowed to manage the bot (get yours from @userinfobot)
ADMIN_IDS=111111111
# Default timezone (IANA name). Each admin can override it in /settings by sharing their location.
TIMEZONE=UTC

# --- Optional ---
# DATABASE_URL=sqlite+aiosqlite:///var/jakov.db
# DATABASE_URL=postgresql+asyncpg://jakov:secret@db:5432/jakov
# LOG_LEVEL=INFO
# RUN_MODE=polling            # or: webhook
# WEBHOOK_BASE_URL=https://bot.example.com
# WEBHOOK_PATH=/telegram
# WEBHOOK_SECRET=long-random-string
# WEBHOOK_HOST=0.0.0.0
# WEBHOOK_PORT=8080
# EMOJI_TEST_PACK=RestrictedEmoji

# --- External services (later phases) ---
VIRUSTOTAL_API_KEY=
SAFE_BROWSING_API_KEY=
ANTHROPIC_API_KEY=

# --- Scheduler (optional) ---
# CATCHUP_GRACE_MINUTES=15        # send a late run if less than this late, otherwise skip + log
# APPROVAL_TIMEOUT_MINUTES=30     # unanswered approval requests are skipped after this
# MIN_INTERVAL_MINUTES=5          # shortest allowed "every N minutes" schedule
# SCHEDULER_TICK_SECONDS=5

# --- Local AI writer (Ollama, optional; templates are used when it's off) ---
# LLM_ENABLED=true
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=gemma3:1b          # ~800 MB: `ollama pull gemma3:1b`
# LLM_TIMEOUT_S=45
